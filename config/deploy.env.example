# Copy to config/deploy.env (ignored by Git) and fill in. Read by bin/deploy.
CLOUDFLARE_ACCOUNT_ID=0123456789abcdef0123456789abcdef
PAGES_PROJECT=passforme
# How bin/deploy obtains the API token (Pages write on the account). The
# token itself never goes in this file. Alternatively, export
# CLOUDFLARE_API_TOKEN before running bin/deploy.
CLOUDFLARE_API_TOKEN_COMMAND='passforme get "Cloudflare" --stdout'
